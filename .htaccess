# Canonical host: https://mimice.hr (https, no www).
# Collapses both http-> https and www -> non-www into a single redirect hop,
# so Google always sees one canonical URL instead of a redirect chain.
# Only takes effect on the Hostinger-served copy of this site (deployed via
# its GitHub auto-deploy) — GitHub Pages ignores .htaccess entirely.
RewriteEngine On

RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
